<?php

/**
 * @file
 * Install, update and uninstall functions for the Cucumber core module.
 */

use Drupal\Core\Recipe\Recipe;
use Drupal\Core\Recipe\RecipeRunner;

/**
 * Implements hook_install().
 */
function cucumber_core_install() {

  // Core skips this module's config/install entities (the Feature Directory
  // vocabulary and its field storages) when cucumber_core is installed in one
  // go together with its long dependency chain. Install them explicitly so a
  // plain `drush en cucumber_core` ends up with the same configuration as the
  // Cucumber distribution.
  \Drupal::service('config.installer')->installDefaultConfig('module', 'cucumber_core');

  // A recipe to manage default Media Directories settings.
  $media_directories_settings_recipe = Recipe::createFromDirectory(__DIR__ . '/recipes/media-directories-settings');
  RecipeRunner::processRecipe($media_directories_settings_recipe);

  // The dashboards this module ships live in config/optional, which core only
  // installs once every module in the install list has finished. Install them
  // now so the recipe below can grant their "can view ... dashboard"
  // permissions.
  \Drupal::service('config.installer')->installOptionalConfig();

  // A recipe to manage the default and admin dashboards.
  $dashboards_recipe = Recipe::createFromDirectory(__DIR__ . '/recipes/cucumber-dashboards');
  RecipeRunner::processRecipe($dashboards_recipe);

}
