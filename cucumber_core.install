<?php

/**
 * @file
 * Install, update and uninstall functions for the Cucumber core module.
 */

use Drupal\Core\Recipe\Recipe;
use Drupal\Core\Recipe\RecipeRunner;

/**
 * Implements hook_install().
 */
function cucumber_core_install($is_syncing) {
  // Configuration imports bring their own configuration.
  if (\Drupal::isConfigSyncing()) {
    return;
  }

  // When the module is installed on its own, apply its default recipe. When
  // the default recipe installs the module, the recipe is already applied.
  if (!$is_syncing) {
    // Core skips this module's config/install entities (the Feature Directory
    // vocabulary and its field storages) when cucumber_core is installed in
    // one go together with its long dependency chain. Install them explicitly
    // so a plain `drush en cucumber_core` ends up with the same configuration
    // as the Cucumber distribution.
    \Drupal::service('config.installer')->installDefaultConfig('module', 'cucumber_core');

    // The dashboards this module ships live in config/optional, which core
    // only installs once every module in the install list has finished.
    // Install them now so the recipe below can grant their "can view ...
    // dashboard" permissions.
    \Drupal::service('config.installer')->installOptionalConfig();

    RecipeRunner::processRecipe(Recipe::createFromDirectory(__DIR__ . '/recipes/default'));
  }
}

/**
 * Expand the features listing without jQuery UI.
 */
function cucumber_core_update_11001() {
  $view = \Drupal::configFactory()->getEditable('views.view.features');

  if ($view->isNew()) {
    return t('The features view is not installed, nothing to update.');
  }

  $display = $view->get('display.default.display_options');
  if (($display['style']['type'] ?? '') !== 'views_accordion') {
    return t('The features view no longer uses the jQuery UI accordion, nothing to update.');
  }

  $display['style'] = [
    'type' => 'cucumber_core_disclosure',
    'options' => [
      'grouping' => [],
      'row_class' => $display['style']['options']['row_class'] ?? 'gherkin-script',
      'default_row_class' => $display['style']['options']['default_row_class'] ?? TRUE,
      'open_first' => TRUE,
    ],
  ];
  $view->set('display.default.display_options', $display);

  $modules = $view->get('dependencies.module') ?? [];
  $modules = array_values(array_diff($modules, ['views_accordion']));
  if (!in_array('cucumber_core', $modules, TRUE)) {
    $modules[] = 'cucumber_core';
  }
  sort($modules);
  $view->set('dependencies.module', $modules);
  $view->save(TRUE);

  return t('The features listing now uses the disclosure list style.');
}
